# Neon: connection string "pooled" dal dashboard Neon (Connection Details)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Segreto per firmare la sessione (almeno 32 caratteri casuali): openssl rand -base64 32
SESSION_SECRET=

# Password iniziali dei due utenti (usate da npm run db:migrate)
MC_PASSWORD=
SC_PASSWORD=
# Password Admin All (solo locale, per npm run db:migrate; login nascosto su /accesso-riservato). Minimo 16 caratteri
ADMIN_PASSWORD=

# Facoltativo: token per lo script di verifica settimanale (scripts/weekly-check.mjs). Minimo 24 caratteri casuali. Se vuoto il token e disattivo
BACKUP_TOKEN=

# Vercel Blob (Storage > Blob > Create). Creato in automatico se colleghi lo store al progetto
BLOB_READ_WRITE_TOKEN=

# Cloudflare Turnstile (facoltativo: se vuote il login resta senza captcha)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
