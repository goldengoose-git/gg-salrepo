# Neon: connection string "pooled" dal dashboard Neon (Connection Details)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Segreto per firmare la sessione (almeno 32 caratteri casuali): openssl rand -base64 32
SESSION_SECRET=

# Password iniziali dei due utenti (usate da npm run db:migrate)
MC_PASSWORD=
SC_PASSWORD=

# Vercel Blob (Storage > Blob > Create). Creato in automatico se colleghi lo store al progetto
BLOB_READ_WRITE_TOKEN=
